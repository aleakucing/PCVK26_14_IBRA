        "#percobaan 7\n",
        "# Filter Suasana Pagi dan Kabut\n",
        "# Step 1: Kurangi kontras & cerahkan\n",
        "alpha = 0.9  # contrast\n",
        "beta = 20    # brightness\n",
        "soft = cv.convertScaleAbs(img, alpha=alpha, beta=beta)\n",
