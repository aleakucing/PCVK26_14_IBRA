        "def convolotion2d(image, kernel, stride, padding):\n",
        "    image = np.array(image)\n",
        "    kernel = np.array(kernel)\n",
        "    if padding > 0:\n",
        "        padded_image = np.pad(image, ((padding, padding), (padding, padding)), mode='constant', constant_values=0)\n",
        "    else:\n",
        "        padded_image = image\n",
        "    image_h, image_w = image.shape\n",
        "    kernel_h, kernel_w = kernel.shape\n",
        "\n",
        "    out_h = (image_h + 2 * padding - kernel_h)\n",
        "    out_w = (image_w + 2 * padding - kernel_w)\n",
        "\n",
        "    output = np.zeros((out_h, out_w))\n",
        "\n",
        "    for i in range(out_h):\n",
        "        for j in range(out_w):\n",
        "            h_start = i * stride\n",
        "            h_end = h_start + kernel_h\n",
        "            w_start = j * stride\n",
        "            w_end = w_start + kernel_w\n",
        "\n",
        "            patch = padded_image[h_start:h_end, w_start:w_end]\n",
        "            output[i, j] = np.sum(patch * kernel)\n",
        "\n",
        "    return output"
      ],
